@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">Job Search Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <div class="display-6 fw-bold">@Model.Total</div>
                <div class="text-muted">Total tracked</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card text-center h-100 shadow-sm border-warning">
            <div class="card-body">
                <div class="display-6 fw-bold">@Model.Count(ApplicationStatus.Saved)</div>
                <div class="text-muted">Saved</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card text-center h-100 shadow-sm border-primary">
            <div class="card-body">
                <div class="display-6 fw-bold">@Model.Count(ApplicationStatus.Applied)</div>
                <div class="text-muted">Applied</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card text-center h-100 shadow-sm border-info">
            <div class="card-body">
                <div class="display-6 fw-bold">@Model.Count(ApplicationStatus.Interview)</div>
                <div class="text-muted">Interviews</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card text-center h-100 shadow-sm border-success">
            <div class="card-body">
                <div class="display-6 fw-bold">@Model.Count(ApplicationStatus.Offer)</div>
                <div class="text-muted">Offers</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card text-center h-100 shadow-sm border-secondary">
            <div class="card-body">
                <div class="display-6 fw-bold">@Model.Count(ApplicationStatus.Rejected)</div>
                <div class="text-muted">Rejected</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-center">
                <h5 class="card-title">Response rate</h5>
                <div class="progress" style="height: 24px;">
                    <div class="progress-bar bg-info" role="progressbar"
                         style="width: @Model.ResponseRate%;">@Model.ResponseRate%</div>
                </div>
                <small class="text-muted mt-1">Share of applications that led to an interview or offer</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">Follow-ups due (next 7 days)</div>
            <ul class="list-group list-group-flush">
                @if (!Model.FollowUpsDue.Any())
                {
                    <li class="list-group-item text-muted">Nothing due — good time to apply to more roles.</li>
                }
                @foreach (var app in Model.FollowUpsDue)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@app.Company — @app.Title</span>
                        <span class="badge bg-warning text-dark">@app.FollowUpDate?.ToString("MMM d")</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">Top matches still saved (apply to these next)</div>
            <ul class="list-group list-group-flush">
                @if (!Model.TopMatches.Any())
                {
                    <li class="list-group-item text-muted">No saved applications yet.</li>
                }
                @foreach (var app in Model.TopMatches)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@app.Company — <a href="@app.Url" target="_blank" rel="noopener">@app.Title</a></span>
                        <span class="badge bg-success">@app.MatchScore</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
